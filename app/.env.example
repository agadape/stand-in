# --- Claude (the judge) ---
# Or sign in with `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# --- Monad ---
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
# Printed by `forge script script/Deploy.s.sol` (see README).
STANDIN_ADDRESS=0x0000000000000000000000000000000000000000

# --- Server wallets ---
# 32 random bytes. Every twin's wallet key is derived from this and the twin's slug.
# Generate: node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
TWIN_KEY_SEED=
# A funded testnet key that tops up twin gas and pays demo pots. https://faucet.monad.xyz
FUNDER_PRIVATE_KEY=
TWIN_GAS_TOPUP_MON=0.2
TWIN_GAS_MIN_MON=0.05
DEMO_POT_MON=0.1

# --- Client-side chain reads (the "Verify on Monad" button) ---
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# --- Abuse and cost control (every attempt costs gas and a judge call) ---
LIMIT_TWINS_PER_DAY=50
LIMIT_TWINS_PER_OWNER_DAY=3
LIMIT_TWINS_PER_IP_DAY=5
LIMIT_ATTEMPTS_PER_DAY=300
LIMIT_ATTEMPTS_PER_TWIN_HOUR=12
LIMIT_ATTEMPTS_PER_ADDRESS_HOUR=6
LIMIT_ATTEMPTS_PER_IP_HOUR=10
# Below this funder balance the app refuses new twins/attempts instead of failing mid-flow.
MIN_FUNDER_MON=0.3

# --- Database (libsql: a local file in dev, Turso in prod) ---
DATABASE_URL=file:./standin.db
DATABASE_AUTH_TOKEN=

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "standin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "app",
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "standin-video",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../standin-video/app",
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    }
  ]
}
